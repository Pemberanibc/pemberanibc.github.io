{
  "rules": {
    "admins": {
      ".read": false,
      ".write": false
    },

    "pt2": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "pt3": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "certLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$entry": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'pair', 'kind', 'format', 'at']) && newData.child('at').val() === now",
        "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 60" },
        "pair": { ".validate": "newData.isString() && newData.val().matches(/^g[12]p[1-6]$/)" },
        "kind": { ".validate": "newData.isString() && newData.val().matches(/^(participation|champions|runners-up|third)$/)" },
        "format": { ".validate": "newData.isString() && newData.val().matches(/^(pdf|jpg|share)$/)" },
        "at": { ".validate": true },
        "$other": { ".validate": false }
      }
    },

    "familyNight": {
      ".read": false,
      ".write": false
    }
  }
}
